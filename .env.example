# Environment Variables Example (.env.example)
# Rename this file to .env.local to configure local variables.

# Option 1: Formspree Form ID (Recommended)
NEXT_PUBLIC_FORMSPREE_ID=

# Option 2: Full Formspree Endpoint URL
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# Note: If neither is set, the contact form automatically falls back to mailto: with pre-filled inputs.
